# Сервер приложения. Положить в /etc/systemd/system/petrofoot.service
#   systemctl daemon-reload && systemctl enable --now petrofoot
[Unit]
Description=Petrofoot tournament API
After=network.target

[Service]
User=petrofoot
Group=petrofoot
WorkingDirectory=/opt/petrofoot
# Один процесс: в нём работает ежедневная копия базы, а SQLite не любит несколько писателей
ExecStart=/opt/petrofoot/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/petrofoot

[Install]
WantedBy=multi-user.target
