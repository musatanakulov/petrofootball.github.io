# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# Новый токен от @BotFather (старый нужно отозвать командой /revoke)
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_TELEGRAM_IDS=

# 1 = админ-панель без Telegram, но только с этого же компьютера (localhost).
# Пользователи из интернета (даже через туннель) её не получат.
ALLOW_DEV_ADMIN=0

# Адрес Mini App для кнопки бота
WEBAPP_URL=https://musatanakulov.github.io/petrofootball.github.io/
